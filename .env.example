# Koneksi database. Salin file ini jadi .env lalu sesuaikan.
#
# DB_SERVER: nama server. Kalau instance-nya named, tulis dengan backslash
#            (LTP-2017-023\SQL2017). Instance default cukup namanya saja.
DB_SERVER=LTP-2017-023
DB_DATABASE=bnm-data
DB_USER=pir_reader
DB_PASSWORD=
DB_ENCRYPT=false
PORT=3000

# Cara menjalankan query. Isinya sama, hasilnya sama — beda cara kerja saja.
#
#   (kosong)  tabel temporer. Lebih cepat, tapi butuh izin CREATE TABLE
#             dan menumpang di tempdb server.
#
#   murni     CTE, SELECT saja. Lebih lambat, tapi tidak menulis apa pun
#             ke server. Pakai ini kalau login hanya diberi hak baca —
#             misalnya saat menyambung ke database produksi.
#
# DB_MODE=murni
